{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "services": {
    "backend": {
      "source": {
        "context": "backend",
        "dockerfilePath": "backend/Dockerfile.prod"
      },
      "variables": {
        "OTP_MOCK": "true",
        "OCR_ENGINE": "mock",
        "TWILIO_MOCK": "true",
        "SMTP_MOCK": "true",
        "CASHFREE_MOCK": "true",
        "GOOGLE_VISION_ENABLED": "false",
        "ENVIRONMENT": "staging"
      }
    },
    "frontend": {
      "source": {
        "context": "frontend",
        "dockerfilePath": "frontend/Dockerfile.prod"
      },
      "variables": {}
    },
    "minio": {
      "source": {
        "image": "minio/minio:latest"
      },
      "variables": {
        "MINIO_ROOT_USER": "minioadmin",
        "MINIO_ROOT_PASSWORD": "minioadmin"
      },
      "deploy": {
        "startCommand": "minio server /data --console-address :9001"
      }
    }
  }
}
