# ── Database ──
POSTGRES_USER=lekhajokha
POSTGRES_PASSWORD=lekhajokha_dev
POSTGRES_DB=lekhajokha
DATABASE_URL=postgresql+asyncpg://lekhajokha:lekhajokha_dev@localhost:5432/lekhajokha

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lekhajokha

# ── JWT ──
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP (SMS provider) ──
# For dev, OTP is mocked. Set OTP_MOCK=true to use fixed OTP 123456
OTP_MOCK=true
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# ── OCR Engine ──
# Options: "paddleocr" (default, self-hosted), "google_vision", "easyocr", "mock"
OCR_ENGINE=paddleocr
OCR_LANG=en
# GOOGLE_VISION_API_KEY=   # only needed if OCR_ENGINE=google_vision

# ── App ──
APP_NAME=LekhaJokha
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Twilio (WhatsApp) ──
# For dev, WhatsApp is mocked. Set TWILIO_MOCK=false for real Twilio.
TWILIO_MOCK=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=+14155238886

# ── SMTP (Email) ──
# For dev, SMTP is mocked. Set SMTP_MOCK=false for real SMTP.
SMTP_MOCK=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@lekhajokha.local

# ── Cashfree (UPI VPA verification) ──
# For dev, Cashfree is mocked. Set CASHFREE_MOCK=false for real API.
CASHFREE_MOCK=true
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_BASE_URL=https://api.cashfree.com

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
