# ── Database ──
POSTGRES_USER=lekhajokha
POSTGRES_PASSWORD=lekhajokha_dev
POSTGRES_DB=lekhajokha
DATABASE_URL=postgresql+asyncpg://lekhajokha:lekhajokha_dev@localhost:5432/lekhajokha

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lekhajokha

# ── JWT ──
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP (SMS provider) ──
# For dev, OTP is mocked. Set OTP_MOCK=true to use fixed OTP 123456
OTP_MOCK=true
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# ── App ──
APP_NAME=LekhaJokha
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
